# Poker Tutor – configurazione per Apache (ignorata dagli altri server)
DirectoryIndex index.html

<IfModule mod_headers.c>
  # index.html sempre aggiornato: dopo un nuovo deploy gli utenti vedono subito la nuova versione
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Gli asset hanno l'hash nel nome: possono restare in cache a lungo
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
